# Copy this file to .env and fill in your values. The scripts read ONLY .env.
# Do NOT put real credentials in this file — it is a shareable template.
FIABOX_BASE=https://fiabox.fia.com

# Your fiabox login (email) and password
FIABOX_LOGIN=your-email@fia.com
FIABOX_PASSWORD=your-password

# Only if you have a separate admin-console credential for /ws/admin/api/auth.
# Leave blank if you just have your normal account login above.
FIABOX_ADMIN_SECRET=
